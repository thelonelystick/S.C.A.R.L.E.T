{
  "name": "scarlet",
  "version": "0.1.0",
  "private": true,
  "description": "SCARLET personal AI desktop assistant",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k \"vite --config apps/web/vite.config.ts\" \"tsc -p apps/desktop/electron/tsconfig.json --watch\" \"wait-on http://localhost:5173 dist-electron/main.js && electron dist-electron/main.js\"",
    "build": "pnpm typecheck && tsc -p apps/desktop/electron/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/desktop/electron/tsconfig.json --noEmit",
    "start": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0 --port ${PORT:-4173}",
    "preview": "vite preview --config apps/web/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  }
}
